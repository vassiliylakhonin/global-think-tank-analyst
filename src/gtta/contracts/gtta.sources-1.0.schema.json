{
  "$defs": {
    "MemoSource": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "source_id",
        "path"
      ],
      "title": "MemoSource",
      "type": "object"
    },
    "SourceQuote": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
          "title": "Claim Id",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "source_id",
        "text"
      ],
      "title": "SourceQuote",
      "type": "object"
    }
  },
  "$id": "urn:gtta:schema:sources:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "quotes": {
      "items": {
        "$ref": "#/$defs/SourceQuote"
      },
      "title": "Quotes",
      "type": "array"
    },
    "schema_version": {
      "const": "gtta.sources@1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/MemoSource"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "MemoSourceCatalog",
  "type": "object"
}
